# How to sign your own release build
# 1) Create a key (once) in a folder OUTSIDE this project, for example:
#      keytool -genkeypair -v -keystore ~/melyvio-keys/melyvio-release.jks -alias melyvio \
#        -keyalg RSA -keysize 2048 -validity 10000
# 2) Copy this file to  keystore.properties  (same folder as settings.gradle.kts) and fill it in.
#    keystore.properties is git-ignored. NEVER commit it, your .jks file or any password.
storeFile=/full/path/to/melyvio-release.jks
storePassword=your-store-password
keyAlias=melyvio
keyPassword=your-key-password
